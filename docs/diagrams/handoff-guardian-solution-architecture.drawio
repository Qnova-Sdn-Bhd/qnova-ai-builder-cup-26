        </mxCell>
        <mxCell id="text-50" value="Show task and audit trail" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontStyle=1;fontColor=#182B43;fillColor=none;strokeColor=none;" vertex="1" parent="board">
          <mxGeometry x="18" y="38" width="384" height="30" as="geometry" />
        </mxCell>
        <mxCell id="text-51" value="Refresh retains the persisted task.&#xa;Creating a task does not resolve the finding&#xa;or close a commitment.&#xa;Closure requires reviewed acceptance evidence." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#526579;fillColor=none;strokeColor=none;" vertex="1" parent="board">
          <mxGeometry x="18" y="76" width="384" height="125" as="geometry" />
        </mxCell>
        <mxCell id="review-approve" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=0;strokeWidth=2;strokeColor=#1A73E8;endArrow=block;endFill=1;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="review" target="bind">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="approve-execute" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=0;strokeWidth=2;strokeColor=#188038;endArrow=block;endFill=1;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bind" target="transaction">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="board-read" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=0;strokeWidth=2;strokeColor=#188038;endArrow=block;endFill=1;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="transaction" target="board">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="text-52" value="Cross-cutting controls: ID-token verification + server-side membership • Immutable GCS generations + hashes • Durable outbox, leases and fenced publication&#xa;Source authority is a reviewer decision • New uploads do not supersede accepted sources automatically • Changed evidence makes old actions stale&#xa;Synthetic business time is operator-controlled and labeled; real UTC governs authentication, leases and audit occurrence." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#526579;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="70" y="1150" width="1735" height="75" as="geometry" />
        </mxCell>
        <mxCell id="footer-rule" value="" style="rounded=0;arcSize=12;whiteSpace=wrap;html=0;fillColor=#DBE4EE;strokeColor=none;strokeWidth=1.5;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="48" y="1335" width="1784" height="1" as="geometry" />
        </mxCell>
        <mxCell id="text-53" value="A logical workflow, not a claim that every acceptance case has passed • Solid arrows: primary request/data flow • Dashed arrow: validated analysis response" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#526579;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="1353" width="1784" height="25" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
