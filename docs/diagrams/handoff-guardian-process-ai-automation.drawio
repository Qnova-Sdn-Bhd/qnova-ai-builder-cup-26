        <mxCell id="text-73" value="Invalidate stale decisions" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontStyle=1;fontColor=#182B43;fillColor=none;strokeColor=none;" vertex="1" parent="freshness">
          <mxGeometry x="18" y="38" width="499" height="30" as="geometry" />
        </mxCell>
        <mxCell id="text-74" value="New or reviewed evidence increments the revision.&#10;Re-run analysis and create a fresh proposal as needed.&#10;An old approval cannot authorize a changed payload." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#526579;fillColor=none;strokeColor=none;" vertex="1" parent="freshness">
          <mxGeometry x="18" y="76" width="499" height="75" as="geometry" />
        </mxCell>
        <mxCell id="outcome" value="" style="group;" vertex="1" parent="1">
          <mxGeometry x="1415" y="1150" width="595" height="155" as="geometry" />
        </mxCell>
        <mxCell id="outcome-card" value="" style="rounded=1;arcSize=12;fillColor=#E6F4EA;strokeColor=#188038;strokeWidth=1.5;dashed=0;" vertex="1" parent="outcome">
          <mxGeometry x="0" y="0" width="595" height="155" as="geometry" />
        </mxCell>
        <mxCell id="text-75" value="HUMAN-REVIEWED OUTCOME" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#188038;fillColor=none;strokeColor=none;" vertex="1" parent="outcome">
          <mxGeometry x="18" y="13" width="559" height="20" as="geometry" />
        </mxCell>
        <mxCell id="text-76" value="A task records the next step" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontStyle=1;fontColor=#182B43;fillColor=none;strokeColor=none;" vertex="1" parent="outcome">
          <mxGeometry x="18" y="38" width="559" height="30" as="geometry" />
        </mxCell>
        <mxCell id="text-77" value="A blocker task does not establish delivery or acceptance.&#10;Finding disposition and commitment closure are explicit reviews.&#10;Accepted scope always comes from reviewer decisions." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#526579;fillColor=none;strokeColor=none;" vertex="1" parent="outcome">
          <mxGeometry x="18" y="76" width="559" height="75" as="geometry" />
        </mxCell>
        <mxCell id="footer-rule" value="" style="rounded=0;arcSize=12;whiteSpace=wrap;html=0;fillColor=#DBE4EE;strokeColor=none;strokeWidth=1.5;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="48" y="1335" width="2004" height="1" as="geometry" />
        </mxCell>
        <mxCell id="text-78" value="Blue: human decisions • Amber: automated work / OCR • Purple: one AI agent and its capabilities • Green: persisted outcome • Dashed arrows: feedback / ready-state return" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#526579;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="1353" width="2004" height="25" as="geometry" />
