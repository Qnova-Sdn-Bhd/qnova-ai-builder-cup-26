# Handoff Guardian — Google Cloud deployed-prototype settings, edition 2.
# Empty resource values must be supplied before deployment; no credentials are included.
APP_ENV=prototype
AI_PROVIDER=vertex
AGENT_RUNTIME=vertex_agent_engine
AUTH_MODE=identity_platform
STORAGE_BACKEND=firestore
FILE_STORAGE_BACKEND=gcs
QUEUE_BACKEND=cloud_tasks
TASK_BOARD_BACKEND=firestore
ALLOW_LIVE_MODEL_CALLS=true

# Candidate region bundle for synthetic competition data; verify/approve before provisioning.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=
# Current Gemini Flash inference is served in the US multi-region; agent compute remains us-central1.
GEMINI_LOCATION=us
VERTEX_AGENT_ENGINE_RESOURCE_NAME=
FIRESTORE_DATABASE=(default)
GCS_BUCKET=
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=
DOCUMENT_AI_PROCESSOR_VERSION=

# Private worker and durable queue. The worker URL and OIDC audience must be configured exactly.
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=handoff-guardian-work
WORKER_SERVICE_URL=
TASK_INVOKER_SERVICE_ACCOUNT=
SCHEDULER_INVOKER_SERVICE_ACCOUNT=

# API verifies Identity Platform ID tokens, then reads server-side membership.
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
CORS_ALLOW_ORIGINS=
NEXT_PUBLIC_API_BASE_URL=
# These are public web app configuration, not service-account credentials.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Fixed prototype policy bounds; stricter selected processor/model limits still apply.
MAX_UPLOAD_BYTES=10485760
MAX_SOURCE_PAGES=15
MAX_ANALYSIS_SOURCES=30
MAX_ANALYSIS_CHARS=120000
# Per Agent Engine invocation: at most 3 model requests, including all SDK/repair retries.
# Up to 3 durable job attempts permit at most 9 model requests per logical analysis.
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
MODEL_MAX_CALLS=3
DOCUMENT_AI_TIMEOUT_SECONDS=120
TASK_DISPATCH_DEADLINE_SECONDS=300
WORKER_TIMEOUT_SECONDS=300
JOB_LEASE_SECONDS=360
JOB_MAX_ATTEMPTS=3

# Optional phase-06 extensions; disabled in the core build.
AGENT_SEARCH_ENABLED=false
AGENT_SEARCH_SERVING_CONFIG=
BIGQUERY_ENABLED=false
BIGQUERY_DATASET=

# Use ADC for authorized development and attached service accounts in deployment.
# Private secrets, when needed, are Secret Manager references configured by deployment.
# Never add downloaded service-account keys, user tokens, or emulator endpoints here.
